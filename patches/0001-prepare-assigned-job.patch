diff --git a/internal/app/run/before_job.go b/internal/app/run/before_job.go
new file mode 100644
index 00000000..3d4a8123
--- /dev/null
+++ b/internal/app/run/before_job.go
@@ -0,0 +1,22 @@
+// Copyright 2026 The Gitea Authors. All rights reserved.
+// SPDX-License-Identifier: MIT
+
+package run
+
+import (
+	"context"
+	"io"
+	"os/exec"
+	"time"
+)
+
+func runBeforeJob(ctx context.Context, command []string, output io.Writer) error {
+	if len(command) == 0 {
+		return nil
+	}
+	cmd := exec.CommandContext(ctx, command[0], command[1:]...)
+	cmd.Stdout = output
+	cmd.Stderr = output
+	cmd.WaitDelay = 5 * time.Second
+	return cmd.Run()
+}
diff --git a/internal/app/run/before_job_test.go b/internal/app/run/before_job_test.go
new file mode 100644
index 00000000..0d530cce
--- /dev/null
+++ b/internal/app/run/before_job_test.go
@@ -0,0 +1,40 @@
+// Copyright 2026 The Gitea Authors. All rights reserved.
+// SPDX-License-Identifier: MIT
+
+package run
+
+import (
+	"bytes"
+	"context"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestHostProvisioning(t *testing.T) {
+	t.Run("absent", func(t *testing.T) {
+		require.NoError(t, runBeforeJob(t.Context(), nil, &bytes.Buffer{}))
+	})
+	t.Run("completed before execution", func(t *testing.T) {
+		marker := filepath.Join(t.TempDir(), "ready")
+		var output bytes.Buffer
+		require.NoError(t, runBeforeJob(t.Context(), []string{"sh", "-ec", "printf 'line one\\nline two'; printf ready > \"$1\"", "hook", marker}, &output))
+		data, err := os.ReadFile(marker)
+		require.NoError(t, err)
+		require.Equal(t, "ready", string(data))
+		require.Equal(t, "line one\nline two", output.String())
+	})
+	t.Run("failure", func(t *testing.T) {
+		require.Error(t, runBeforeJob(t.Context(), []string{"sh", "-c", "exit 7"}, &bytes.Buffer{}))
+	})
+	t.Run("cancelled", func(t *testing.T) {
+		ctx, cancel := context.WithCancel(t.Context())
+		cancel()
+		start := time.Now()
+		require.Error(t, runBeforeJob(ctx, []string{"sleep", "60"}, &bytes.Buffer{}))
+		require.Less(t, time.Since(start), time.Second)
+	})
+}
