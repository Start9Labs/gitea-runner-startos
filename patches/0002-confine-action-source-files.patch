+func TestRemoteMetadataAndFallbackBoundary(t *testing.T) {
+	for _, target := range []string{"regular", "action.yml", "trampoline.js"} {
+		t.Run(target, func(t *testing.T) {
+			outside := filepath.Join(t.TempDir(), "controller-secret")
+			metadata := []byte("name: fixture\nruns:\n  using: node20\n  main: index.js\n")
+			require.NoError(t, os.WriteFile(outside, metadata, 0o600))
+			setFetch(t, func(_ context.Context, input git.NewGitCloneExecutorInput) (string, string, error) {
+				directory := filepath.Join(input.Dir, "action")
+				if err := os.MkdirAll(directory, 0o700); err != nil {
+					return "", "", err
+				}
+				if target == "regular" {
+					return input.Dir, "", os.WriteFile(filepath.Join(directory, "action.yml"), metadata, 0o600)
+				}
+				return input.Dir, "", os.Symlink(outside, filepath.Join(directory, target))
+			})
+			sar := &stepActionRemote{
+				Step: &model.Step{Uses: "org/repo/action@v1", With: map[string]string{"args": "echo fixture"}},
+				RunContext: &RunContext{
+					Config: &Config{Workdir: t.TempDir(), ActionCacheDir: t.TempDir(), GitHubInstance: "https://example.invalid"},
+					Run:    &model.Run{JobID: "build", Workflow: &model.Workflow{Jobs: map[string]*model.Job{"build": {}}}},
+				},
+				readAction: readActionImpl,
+			}
+			err := sar.prepareActionExecutor()(t.Context())
+			if target == "regular" {
+				require.NoError(t, err)
+			} else {
+				require.Error(t, err)
+			}
+			contents, err := os.ReadFile(outside)
+			require.NoError(t, err)
+			require.Equal(t, metadata, contents)
+		})
+	}
+}
+
+func TestRemoteDockerBuildBoundary(t *testing.T) {
+	root := t.TempDir()
+	repository := filepath.Join(root, "repository")
+	outside := filepath.Join(root, "repository-neighbor")
+	for _, directory := range []string{repository, outside, filepath.Join(repository, "actions"), filepath.Join(repository, "actions", "nested")} {
+		require.NoError(t, os.MkdirAll(directory, 0o700))
+		require.NoError(t, os.WriteFile(filepath.Join(directory, "Dockerfile"), []byte("FROM scratch\n"), 0o600))
+	}
+	require.NoError(t, os.Symlink(outside, filepath.Join(repository, "escape-dir")))
+	require.NoError(t, os.Symlink(filepath.Join(outside, "Dockerfile"), filepath.Join(repository, "escape-file")))
+	require.NoError(t, os.Symlink("actions", filepath.Join(repository, "internal-dir")))
+	for _, test := range []struct {
+		name, action, image, expected string
+		invalid                       bool
+	}{
+		{"root", "", "Dockerfile", repository, false},
+		{"nested", "actions/nested", "Dockerfile", filepath.Join(repository, "actions", "nested"), false},
+		{"internal-parent", "actions/nested", "../Dockerfile", filepath.Join(repository, "actions"), false},
+		{"internal-link", "", "internal-dir/Dockerfile", filepath.Join(repository, "actions"), false},
+		{"parent", "", "../repository-neighbor/Dockerfile", "", true},
+		{"action-parent", "../repository-neighbor", "Dockerfile", "", true},
+		{"absolute-image", "", filepath.Join(outside, "Dockerfile"), "", true},
+		{"absolute-action", outside, "Dockerfile", "", true},
+		{"linked-directory", "", "escape-dir/Dockerfile", "", true},
+		{"linked-file", "", "escape-file", "", true},
+		{"directory", "", "actions", "", true},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			directory, filename, err := remoteActionBuildContext(repository, test.action, test.image)
+			if test.invalid {
+				require.Error(t, err)
+				return
+			}
+			require.NoError(t, err)
+			expected, err := filepath.EvalSymlinks(test.expected)
+			require.NoError(t, err)
+			require.Equal(t, expected, directory)
+			require.Equal(t, "Dockerfile", filename)
+		})
+	}
+}
+
+func TestActionBundleReadWriteBoundarySymlinkedRepository(t *testing.T) {
+	cache := t.TempDir()
+	repository := filepath.Join(cache, "repository")
+	require.NoError(t, os.Mkdir(repository, 0o700))
+	linkedCache := filepath.Join(t.TempDir(), "cache")
+	require.NoError(t, os.Symlink(cache, linkedCache))
+	repository = filepath.Join(linkedCache, "repository")
+	script := filepath.Join(repository, "index.js")
+	require.NoError(t, os.WriteFile(script, []byte(gateTSC), 0o600))
+	action := &model.Action{Runs: model.ActionRuns{Using: "node20", Main: "index.js"}}
+	scripts := actionScriptPaths(repository, repository, action)
+	require.Len(t, scripts, 1)
+	require.Equal(t, "index.js", scripts[0])
+	patched := patchedScripts(t.Context(), repository, scripts)
+	require.Len(t, patched, 1)
+	require.Equal(t, "index.js", patched[0].Name)
+	require.Equal(t, int64(0o600), patched[0].Mode)
+	require.True(t, gateOpened(patched[0].Body))
+	original, err := os.ReadFile(script)
+	require.NoError(t, err)
+	require.Equal(t, gateTSC, string(original))
+}
+
+func TestActionBundleReadWriteBoundary(t *testing.T) {
+	repository := t.TempDir()
+	outside := filepath.Join(t.TempDir(), "private.js")
+	require.NoError(t, os.WriteFile(outside, []byte(gateTSC), 0o600))
+	script := filepath.Join(repository, "index.js")
+	require.NoError(t, os.Symlink(outside, script))
+	source, err := os.OpenRoot(repository)
+	require.NoError(t, err)
+	defer source.Close()
+	original, _, err := patchedScript(source, "index.js")
+	require.Error(t, err)
+	require.Nil(t, original)
+	require.Empty(t, patchedScripts(t.Context(), repository, []string{"index.js"}))
+	require.NoError(t, os.Remove(script))
+	require.NoError(t, os.WriteFile(script, []byte(gateTSC), 0o600))
+	action := &model.Action{Runs: model.ActionRuns{Using: "node20", Main: "index.js"}}
+	scripts := actionScriptPaths(repository, repository, action)
+	require.Equal(t, []string{"index.js"}, scripts)
+	patched := patchedScripts(t.Context(), repository, scripts)
+	require.Len(t, patched, 1)
+	require.True(t, gateOpened(patched[0].Body))
+	contents, err := os.ReadFile(script)
+	require.NoError(t, err)
+	require.Equal(t, gateTSC, string(contents))
+	require.NoError(t, os.Remove(script))
+	require.NoError(t, os.Symlink(outside, script))
+	require.Empty(t, patchedScripts(t.Context(), repository, scripts))
+	contents, err = os.ReadFile(outside)
+	require.NoError(t, err)
+	require.Equal(t, gateTSC, string(contents))
+}
