+// Copyright 2026 The Gitea Authors. All rights reserved.
+// SPDX-License-Identifier: MIT
+
+//go:build !(WITHOUT_DOCKER || !(linux || darwin || windows || netbsd))
+
+package container
+
+import (
+	"archive/tar"
+	"io"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestBuildContextIgnoreBoundary(t *testing.T) {
+	for _, linked := range []bool{false, true} {
+		t.Run(map[bool]string{false: "regular", true: "outside-link"}[linked], func(t *testing.T) {
+			contextDir := t.TempDir()
+			require.NoError(t, os.WriteFile(filepath.Join(contextDir, "Dockerfile"), []byte("FROM scratch\n"), 0o600))
+			if linked {
+				outside := filepath.Join(t.TempDir(), "private-ignore")
+				require.NoError(t, os.WriteFile(outside, []byte("hidden\n"), 0o600))
+				require.NoError(t, os.Symlink(outside, filepath.Join(contextDir, ".dockerignore")))
+			} else {
+				require.NoError(t, os.WriteFile(filepath.Join(contextDir, ".dockerignore"), []byte("hidden\n"), 0o600))
+			}
+			archive, err := createBuildContext(t.Context(), contextDir, "Dockerfile")
+			if linked {
+				require.Error(t, err)
+				return
+			}
+			require.NoError(t, err)
+			defer archive.Close()
+			reader := tar.NewReader(archive)
+			found := false
+			for {
+				header, err := reader.Next()
+				if err == io.EOF {
+					break
+				}
+				require.NoError(t, err)
+				found = found || header.Name == "Dockerfile"
+			}
+			require.True(t, found)
+		})
+	}
+}
