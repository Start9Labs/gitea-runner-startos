diff --git a/act/runner/action_source.go b/act/runner/action_source.go
new file mode 100644
index 00000000..7b400668
--- /dev/null
+++ b/act/runner/action_source.go
@@ -0,0 +1,48 @@
+// Copyright 2026 The Gitea Authors. All rights reserved.
+// SPDX-License-Identifier: MIT
+
+package runner
+
+import (
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+)
+
+func remoteActionBuildContext(repository, actionPath, image string) (string, string, error) {
+	name := filepath.Join(actionPath, image)
+	if filepath.IsAbs(actionPath) || filepath.IsAbs(image) || !filepath.IsLocal(name) {
+		return "", "", errors.New("action Dockerfile must remain inside its repository")
+	}
+	source, err := os.OpenRoot(repository)
+	if err != nil {
+		return "", "", err
+	}
+	defer source.Close()
+	file, err := source.Open(name)
+	if err != nil {
+		return "", "", fmt.Errorf("open action Dockerfile: %w", err)
+	}
+	info, err := file.Stat()
+	file.Close()
+	if err != nil {
+		return "", "", err
+	}
+	if !info.Mode().IsRegular() {
+		return "", "", errors.New("action Dockerfile is not a regular file")
+	}
+	canonicalRepository, err := filepath.EvalSymlinks(repository)
+	if err != nil {
+		return "", "", err
+	}
+	contextDir, err := filepath.EvalSymlinks(filepath.Join(canonicalRepository, filepath.Dir(name)))
+	if err != nil {
+		return "", "", err
+	}
+	relative, err := filepath.Rel(canonicalRepository, contextDir)
+	if err != nil || !filepath.IsLocal(relative) {
+		return "", "", errors.New("action build context escapes its repository")
+	}
+	return contextDir, filepath.Base(name), nil
+}
