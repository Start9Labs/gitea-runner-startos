@@ -0,0 +1,37 @@
+// Copyright 2026 The Gitea Authors. All rights reserved.
+// SPDX-License-Identifier: MIT
+
+package runner
+
+import (
+	"testing"
+
+	"gitea.com/gitea/runner/internal/pkg/labels"
+
+	"gitea.dev/actionslib/pkg/model"
+	"github.com/stretchr/testify/require"
+	"go.yaml.in/yaml/v4"
+)
+
+func TestDockerImagePlatformSelection(t *testing.T) {
+	label, err := labels.Parse("linux-arm64:docker://example/image:tag?platform=linux/arm64")
+	require.NoError(t, err)
+	configured := labels.Labels{label}
+	var runsOn, services yaml.Node
+	require.NoError(t, runsOn.Encode([]string{"linux-${{ matrix.arch }}"}))
+	require.NoError(t, services.Encode(map[string]any{"database": map[string]any{"image": "example/database:tag"}}))
+	rc := &RunContext{
+		Config: &Config{Workdir: t.TempDir(), ContainerArchitecture: "linux/amd64", DockerImagePlatformPicker: configured.PickDockerImagePlatform},
+		Run:    &model.Run{JobID: "build", Workflow: &model.Workflow{Jobs: map[string]*model.Job{"build": {RawRunsOn: runsOn, RawServices: services}}}},
+		Matrix: map[string]any{"arch": "arm64"},
+	}
+	rc.ExprEval = rc.NewExpressionEvaluator(t.Context())
+	require.Equal(t, "linux/arm64", rc.dockerImagePlatform(t.Context()))
+	inputs, err := rc.jobServices(t.Context(), "network")
+	require.NoError(t, err)
+	require.Equal(t, "linux/arm64", inputs["database"].Platform)
+	rc.Matrix["arch"] = "unknown"
+	require.Equal(t, "linux/amd64", rc.dockerImagePlatform(t.Context()))
+	rc.Config.DockerImagePlatformPicker = nil
+	require.Equal(t, "linux/amd64", rc.dockerImagePlatform(t.Context()))
+}
