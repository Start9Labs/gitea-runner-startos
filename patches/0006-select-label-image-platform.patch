 }
 
@@ -68,28 +83,43 @@ func (l Labels) RequireDocker() bool {
 
 // PickPlatform returns the platform of the first runs-on entry this runner has a label for, or "".
 func (l Labels) PickPlatform(runsOn []string) string {
