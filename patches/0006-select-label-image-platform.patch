@@ -0,0 +1,35 @@
+// Copyright 2026 The Gitea Authors. All rights reserved.
+// SPDX-License-Identifier: MIT
+
+package labels
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestDockerPlatformLabel(t *testing.T) {
+	arm, err := Parse("linux-arm64:docker://example/image:tag?platform=linux/arm64")
+	require.NoError(t, err)
+	native, err := Parse("native:docker://example/image:tag")
+	require.NoError(t, err)
+	configured := Labels{arm, native}
+	require.Equal(t, "example/image:tag", configured.PickPlatform([]string{"self-hosted", "linux-arm64"}))
+	require.Equal(t, "linux/arm64", configured.PickDockerImagePlatform([]string{"self-hosted", "linux-arm64"}))
+	require.Empty(t, configured.PickDockerImagePlatform([]string{"native", "linux-arm64"}))
+	require.Empty(t, configured.PickPlatform([]string{"unmatched"}))
+	encoded := configured.ToStrings()
+	roundtrip, err := Parse(encoded[0])
+	require.NoError(t, err)
+	require.Equal(t, arm, roundtrip)
+	for _, query := range []string{"platform=", "platform=linux/arm64&platform=linux/amd64", "other=value", "platform=%"} {
+		_, err := Parse("bad:docker://image?" + query)
+		require.Error(t, err)
+	}
+	for _, value := range []string{"pool:id?question", "host:host", "cluster:kubernetes://image"} {
+		label, err := Parse(value)
+		require.NoError(t, err)
+		require.Equal(t, []string{value}, (Labels{label}).ToStrings())
+	}
+}
