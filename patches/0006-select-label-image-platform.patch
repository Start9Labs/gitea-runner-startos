@@ -52,6 +56,17 @@ func Parse(str string) (*Label, error) {
 			Opaque: true,
 		}, nil
 	}
+	if label.Schema == SchemeDocker {
+		image, query, found := strings.Cut(label.Arg, "?")
+		if found {
+			values, err := url.ParseQuery(query)
+			if err != nil || len(values) != 1 || len(values[OptionPlatform]) != 1 || values.Get(OptionPlatform) == "" {
+				return nil, fmt.Errorf("invalid Docker label options %q", query)
+			}
+			label.Arg = image
+			label.ImagePlatform = values.Get(OptionPlatform)
+		}
