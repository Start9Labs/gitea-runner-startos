 		switch label.Schema {
 		case SchemeDocker:
-			// "//" will be ignored
-			platforms[label.Name] = strings.TrimPrefix(label.Arg, "//")
+			return strings.TrimPrefix(label.Arg, "//")
 		case SchemeKubernetes:
-			platforms[label.Name] = SchemeKubernetes + ":" + label.Arg
+			return SchemeKubernetes + ":" + label.Arg
 		case SchemeHost:
-			platforms[label.Name] = SelfHostedPlatform
-		default:
-			continue
+			return SelfHostedPlatform
 		}
 	}
-	for _, v := range runsOn {
-		if v, ok := platforms[v]; ok {
-			return v
-		}
+	return ""
+}
+
+// PickDockerImagePlatform returns the matching Docker label's OS/architecture, or empty.
+func (l Labels) PickDockerImagePlatform(runsOn []string) string {
+	if label := l.pick(runsOn); label != nil && label.Schema == SchemeDocker {
+		return label.ImagePlatform
 	}
 	return ""
 }
 
+func (l Labels) pick(runsOn []string) *Label {
+	byName := make(map[string]*Label, len(l))
+	for _, label := range l {
+		switch label.Schema {
+		case SchemeDocker, SchemeKubernetes, SchemeHost:
+			byName[label.Name] = label
+		}
+	}
+	for _, name := range runsOn {
+		if label, ok := byName[name]; ok {
+			return label
+		}
+	}
+	return nil
+}
+
 func (l Labels) Names() []string {
 	names := make([]string, 0, len(l))
 	for _, label := range l {
@@ -108,6 +138,9 @@ func (l Labels) ToStrings() []string {
 				lbl += ":" + label.Arg
 			}
 		}
+		if label.ImagePlatform != "" {
+			lbl += "?" + url.Values{OptionPlatform: {label.ImagePlatform}}.Encode()
+		}
 		ls = append(ls, lbl)
 	}
 	return ls
